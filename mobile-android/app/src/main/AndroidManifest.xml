<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- EF-EP-01/04 : scan des supports externes et EF-EP-11 : interception d'installation. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:name=".GuardApplication"
        android:allowBackup="false"
        android:label="GUARD"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.Light">

        <activity
            android:name=".ui.QuarantineActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- T037 : déclenche le scan à la connexion d'un support externe. -->
        <receiver
            android:name=".scanner.DetectionTrigger"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_MOUNTED" />
                <data android:scheme="file" />
            </intent-filter>
            <!--
                Durcissement (T053) : android.intent.action.PACKAGE_INSTALL n'est
                pas un broadcast système diffusé par Android — ce filtre était
                mort et n'a jamais déclenché l'interception d'installation
                d'APK (EF-EP-11). La détection réelle d'installation utilise
                android.intent.action.PACKAGE_ADDED avec le scheme "package".
            -->
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
